{
    "version": "0.2.0",
    "configurations": [
      {
        "type": "node",
        "request": "launch",
        "name": "Debug test",
        "skipFiles": ["<node_internals>/**"],
        "runtimeArgs": ["--test", "--test-reporter=spec", "--test-concurrency=1"],
        "env": {
          "NODE_ENV": "development",
          "DHJN_ENV": "test",
        },
        "stopOnEntry": true
      }
    ]
  }